# OpenShift / RHOAI
NAMESPACE=my-rag-project

# LLM Configuration (Granite via KServe/vLLM)
LLM_ENDPOINT=https://granite-llm-my-rag-project.apps.cluster.example.com
LLM_API_KEY=
LLM_MODEL_URI=s3://models/ibm-granite/granite-3.3-8b-instruct

# Embedding Model (nomic-embed-text via KServe/vLLM)
EMBEDDING_ENDPOINT=https://nomic-embed-my-rag-project.apps.cluster.example.com
EMBEDDING_API_KEY=
EMBEDDING_MODEL_URI=s3://models/nomic-ai/nomic-embed-text-v1.5

# Document Source
DOCUMENT_DIR=./documents

# Vector Database -- Milvus (default)
MILVUS_URI=http://milvus.my-rag-project.svc.cluster.local:19530
MILVUS_TOKEN=

# Vector Database -- pgvector (alternative)
PG_CONNECTION=postgresql://user:password@postgresql.my-rag-project.svc.cluster.local:5432/vectordb
