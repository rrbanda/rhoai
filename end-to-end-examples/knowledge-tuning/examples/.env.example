# --- Data Generation (Step 01) ---
# Teacher model for Q&A synthesis (any LiteLLM-supported provider)
# Gemini 3.6 Flash is cost-effective (~$0.10 for a full run)
TEACHER_MODEL=gemini/gemini-3.6-flash
MODEL_API_KEY=your-api-key-here
# MODEL_API_BASE=https://your-model-endpoint/v1  # Only needed for custom endpoints

# --- Training (Step 03) ---
# Base model to fine-tune
STUDENT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Paths ---
DOCUMENT_DIR=./documents
OUTPUT_DATA_FOLDER=./generated_output_data
CHECKPOINT_DIR=./checkpoints
