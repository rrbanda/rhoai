# Colang 2.0 flows for financial compliance guardrails.
# Used with NeMo Guardrails on RHOAI 3.4+.
#
# When using only built-in rails (detect sensitive data, regex check),
# this file can contain only comments. Add custom Colang flows here
# to extend guardrail behavior beyond what the built-in rails provide.
#
# Example custom flows are shown below. To activate them, add their
# names to rails.input.flows or rails.output.flows in config.yaml
# and provide matching Python actions in actions.py.

# ---------------------------------------------------------------------------
# Flow: Check message length
# Block excessively long user messages that may indicate prompt injection.
# Requires: actions.py with check_message_length action
# ---------------------------------------------------------------------------

define flow check message length
  $length_result = execute check_message_length
  if $length_result == "blocked_too_long"
    bot inform message too long
    stop
  if $length_result == "warning_long"
    bot warn message long

define bot inform message too long
  "Please keep your message under 500 words for better assistance."

define bot warn message long
  "That's quite detailed! I'll help as best I can."


# ---------------------------------------------------------------------------
# Flow: Check forbidden words
# Block messages containing financial manipulation terms.
# Requires: actions.py with check_forbidden_words action
# ---------------------------------------------------------------------------

define flow check forbidden words
  $forbidden_result = execute check_forbidden_words
  if $forbidden_result != "allowed"
    bot inform forbidden content
    stop

define bot inform forbidden content
  "I can't help with that type of request. Please ask something else."
