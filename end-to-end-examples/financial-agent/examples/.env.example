# --- Data Generation (Step 01) — OPTIONAL ---
# Only needed if generating your own training data. Skip if using sample_data/.
# TEACHER_MODEL=gemini/gemini-3.6-flash
# TEACHER_API_KEY=your-gemini-api-key-here
# LANGFLOW_URL=http://localhost:7860/api/v1/run/your-flow-id
# LANGFLOW_API_KEY=your-langflow-key

# --- Training (Steps 03/03b) ---
# Base model to fine-tune
STUDENT_MODEL=Qwen/Qwen3-4B

# KFP Pipeline endpoint (for 03b_train_kfp_pipeline.py)
# Find in RHOAI Dashboard > Data Science Pipelines > Pipeline Server
KFP_ENDPOINT=https://ds-pipeline-dspa.apps.your-cluster.com

# --- Financial MCP Server (Step 00) ---
MCP_SERVER_URL=http://localhost:8009
MCP_SERVER_NAME=FinanceInsights Advisory Platform

# --- Model Serving (Step 04) ---
MODEL_ENDPOINT=https://financial-agent-predictor.apps.your-cluster.com/v1

# --- Guardrails (Step 06) ---
GUARDRAILS_ENDPOINT=https://nemo-guardrails.apps.your-cluster.com

# --- Deep Agent (Step 07) ---
MODEL_NAME=default
OPENAI_API_KEY=not-needed

# --- OpenShift ---
OPENSHIFT_NAMESPACE=financial-agent
OPENSHIFT_API_URL=https://api.your-cluster.com:6443

# --- Step 05: Evaluation ---
JUDGE_MODEL=openai/gpt-4o
# OPENAI_API_KEY is required for evaluation (LLM-as-judge scoring)
# Set it above if not already configured

# --- Paths ---
OUTPUT_DIR=./generated_data
CHECKPOINT_DIR=./checkpoints
