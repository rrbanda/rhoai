# Teacher model for question synthesis and quality scoring
TEACHER_MODEL=openai/gpt-5.2
TEACHER_API_KEY=your-api-key-here

# Langflow agent configuration (frontier model connected to the financial MCP server)
LANGFLOW_URL=http://localhost:7860/api/v1/run/your-flow-id
LANGFLOW_API_KEY=your-langflow-key

# Student model (the small model you want to train)
STUDENT_MODEL=Qwen/Qwen3-4B

# Financial MCP Server
MCP_SERVER_URL=http://localhost:8009
MCP_SERVER_NAME=FinanceInsights Advisory Platform

# Model serving endpoint (after deployment)
MODEL_ENDPOINT=https://financial-agent-predictor.apps.your-cluster.com/v1

# NeMo Guardrails
GUARDRAILS_ENDPOINT=https://nemo-guardrails.apps.your-cluster.com

# OpenShift
OPENSHIFT_NAMESPACE=financial-agent
OPENSHIFT_API_URL=https://api.your-cluster.com:6443

# Paths
OUTPUT_DIR=./generated_data
CHECKPOINT_DIR=./checkpoints
