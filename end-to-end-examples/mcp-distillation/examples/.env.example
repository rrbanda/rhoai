# Teacher model for question synthesis and quality scoring
TEACHER_MODEL=openai/gpt-5.2
TEACHER_API_KEY=your-api-key-here

# Langflow agent configuration (frontier model connected to your MCP server)
LANGFLOW_URL=http://localhost:7860/api/v1/run/your-flow-id
LANGFLOW_API_KEY=your-langflow-key

# Student model (the small model you want to train)
STUDENT_MODEL=Qwen/Qwen3-4B

# Paths
OUTPUT_DIR=./generated_data
CHECKPOINT_DIR=./checkpoints
